{
  "manifest_version": 3,
  "name": "BMG Shipstation Facilitator",
  "description": "Improve your Shipstation experience with this extension!",
  "version": "1.1.8",
  "action": { "default_popup": "popup.html", "default_icon": "images/bmg-icon-128.png" },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "sessions",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://ship6.shipstation.com/*"
  ],
  "icons": {
    "128": "images/bmg-icon-128.png"
  },
  "content_scripts": [{
    "matches": ["https://ship6.shipstation.com/*"],
    "js": ["showVersion.bundle.js", "content.bundle.js"]
  }]
}
